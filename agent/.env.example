# No private key needed here — the agent generates its own low-stakes "device key" on first
# run (saved to agent/device-key.json, gitignored) and prints its address. That key can ONLY
# report uptime for a machine you explicitly authorize from the website; it can never withdraw
# funds, delist a machine, or change its price. Listing and price are set in the browser with
# your real wallet.

# NodePool contract on Base Sepolia — defaults to the deployed address if left blank
CONTRACT_ADDRESS=0x2D16D7F81ac8a13b1A99E74dFDc94eb6107A8243

# Base Sepolia RPC endpoint
RPC_URL=https://base-sepolia-rpc.publicnode.com

# Port the local health server listens on
HEALTH_PORT=3939

# Stage 3 (SSH access) — requires Docker and ngrok installed and on PATH, and `ngrok config
# add-authtoken <token>` run once (free account, one-time setup). If either tool is missing,
# the agent logs a warning once and keeps running normally with uptime reporting only.

# Docker image the per-rental SSH container runs — must accept USER_NAME/USER_PASSWORD/
# PASSWORD_ACCESS env vars the way linuxserver/openssh-server does.
SSH_IMAGE=linuxserver/openssh-server

# Resource limits applied to every rental's container
SSH_MEMORY_LIMIT=2g
SSH_CPU_LIMIT=2
SSH_PIDS_LIMIT=256
