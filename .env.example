# Private key of the deployer account (no 0x prefix issues — include the 0x)
# NEVER commit your real .env file
PRIVATE_KEY=0xyour_private_key_here

# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Arc Testnet RPC endpoint (used by `npx hardhat run scripts/deploy.js --network arc`)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Optional: for contract verification on BaseScan
BASESCAN_API_KEY=
