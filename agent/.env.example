# Private key of the wallet that will own this machine listing (needs Base Sepolia ETH for gas)
PROVIDER_PRIVATE_KEY=0xyour_private_key_here

# Price this machine rents for, in ETH per hour
PRICE_PER_HOUR=0.001

# NodePool contract on Base Sepolia — defaults to the deployed address if left blank
CONTRACT_ADDRESS=0xc8D26E0aEbB17B6c68F9EBb8483Ac5298537F3A8

# Base Sepolia RPC endpoint
RPC_URL=https://base-sepolia-rpc.publicnode.com

# Port the local health server listens on
HEALTH_PORT=3939

# Public URL for this machine's /health endpoint. Stage 1 has no public exposure yet,
# so this stays a localhost placeholder until Stage 2 adds a tunnel/reverse proxy.
HEALTH_ENDPOINT=http://localhost:3939/health
